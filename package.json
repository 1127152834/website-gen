{
  "name": "website-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "poc:hostinger": "node --env-file=.env poc/hostinger.ts",
    "poc:deepseek": "node --env-file=.env poc/deepseek.ts",
    "poc:pi": "node --env-file=.env poc/pi-agent.ts",
    "poc:cj": "node --env-file=.env poc/cj.ts",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke.ts",
    "smoke:mail": "node scripts/mail-triage-smoke.ts",
    "check:sync": "node --env-file=.env scripts/check-sync.ts",
    "check:models": "node --env-file=.env scripts/check-models.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@hookform/resolvers": "5.2.2",
    "@hostinger/mcp": "2.16.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-query": "5.99.0",
    "@tanstack/react-router": "1.168.22",
    "@tanstack/react-table": "8.21.3",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "imapflow": "2.4.3",
    "mailparser": "3.9.39",
    "nodemailer": "10.1.1",
    "playwright-core": "1.64.1",
    "react-hook-form": "7.72.1",
    "sonner": "2.0.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.167.22",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "productName": "独立站 AI 工厂",
  "description": "独立站 AI 工厂：基于 Hostinger + WordPress + WooCommerce 的建站与运营Web工具",
