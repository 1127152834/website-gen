@import "tailwindcss";
@import "tw-animate-css";
@import "shadcn/tailwind.css";
@import "@fontsource-variable/geist";

@custom-variant dark (&:is(.dark *));

@theme inline {
    --font-heading: var(--font-sans);
    --font-sans: 'Geist Variable', "Microsoft YaHei UI", "PingFang SC", sans-serif;
    --color-sidebar-ring: var(--sidebar-ring);
    --color-sidebar-border: var(--sidebar-border);
    --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
    --color-sidebar-accent: var(--sidebar-accent);
    --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
    --color-sidebar-primary: var(--sidebar-primary);
    --color-sidebar-foreground: var(--sidebar-foreground);
    --color-sidebar: var(--sidebar);
    --color-chart-5: var(--chart-5);
    --color-chart-4: var(--chart-4);
    --color-chart-3: var(--chart-3);
    --color-chart-2: var(--chart-2);
    --color-chart-1: var(--chart-1);
    --color-ring: var(--ring);
    --color-input: var(--input);
    --color-border: var(--border);
    --color-destructive: var(--destructive);
    --color-accent-foreground: var(--accent-foreground);
    --color-accent: var(--accent);
    --color-muted-foreground: var(--muted-foreground);
    --color-muted: var(--muted);
    --color-secondary-foreground: var(--secondary-foreground);
    --color-secondary: var(--secondary);
    --color-primary-foreground: var(--primary-foreground);
    --color-primary: var(--primary);
    --color-popover-foreground: var(--popover-foreground);
    --color-popover: var(--popover);
    --color-card-foreground: var(--card-foreground);
    --color-card: var(--card);
    --color-foreground: var(--foreground);
    --color-background: var(--background);
    --radius-sm: calc(var(--radius) * 0.6);
    --radius-md: calc(var(--radius) * 0.8);
    --radius-lg: var(--radius);
    --radius-xl: calc(var(--radius) * 1.4);
    --radius-2xl: calc(var(--radius) * 1.8);
    --radius-3xl: calc(var(--radius) * 2.2);
    --radius-4xl: calc(var(--radius) * 2.6);
}

:root {
    color-scheme: light;
    --background: #f7f9fc;
    --foreground: #1b283b;
    --card: oklch(1 0 0);
    --card-foreground: #1b283b;
    --popover: oklch(1 0 0);
    --popover-foreground: #1b283b;
    --primary: #285ea8;
    --primary-foreground: oklch(0.985 0 0);
    --secondary: oklch(0.97 0 0);
    --secondary-foreground: oklch(0.205 0 0);
    --muted: oklch(0.97 0 0);
    --muted-foreground: #56657a;
    --accent: #e6eef9;
    --accent-foreground: #234f89;
    --destructive: #b52f3e;
    --border: #dce2eb;
    --input: #c8d1de;
    --ring: #285ea8;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --radius: 0.625rem;
    --sidebar: #f0f3f8;
    --sidebar-foreground: #1b283b;
    --sidebar-primary: #285ea8;
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: #dfe8f5;
    --sidebar-accent-foreground: #234f89;
    --sidebar-border: oklch(0.922 0 0);
    --sidebar-ring: oklch(0.708 0 0);
}

.dark {
    color-scheme: dark;
    --background: #121923;
    --foreground: #e4ebf5;
    --card: #182230;
    --card-foreground: #e4ebf5;
    --popover: #1c2839;
    --popover-foreground: #e4ebf5;
    --primary: #92baff;
    --primary-foreground: #142540;
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: #a7b5c9;
    --accent: #273d5b;
    --accent-foreground: #c4d9ff;
    --destructive: #ff9aa8;
    --border: #344257;
    --input: #45556d;
    --ring: #92baff;
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: #161f2c;
    --sidebar-foreground: #e4ebf5;
    --sidebar-primary: #92baff;
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: #273d5b;
    --sidebar-accent-foreground: #c4d9ff;
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
    }
  body {
    @apply bg-background text-foreground;
    }
  html {
    @apply font-sans;
    }
}

/* 运营状态独立于主色；琥珀只用于等待人工处理的事项。 */
:root {
  --status-running: #285ea8; --status-running-bg: #e6eef9;
  --status-waiting: #8c5709; --status-waiting-bg: #fff1cf;
  --status-done: #226747; --status-done-bg: #e3f2e9;
  --status-failed: #b52f3e; --status-failed-bg: #fce8eb;
  --status-launched: #12685e; --status-launched-bg: #def2ed;
  --text-caption: 0.75rem; --text-body: 0.875rem; --text-section: 1rem; --text-page: 1.5rem;
  --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem; --space-4: 1rem; --space-6: 1.5rem; --space-8: 2rem;
}
.dark {
  --status-running: #a4c7ff; --status-running-bg: #233b5d;
  --status-waiting: #f8cf7c; --status-waiting-bg: #453619;
  --status-done: #91d7b0; --status-done-bg: #1c3a2d;
  --status-failed: #ffacb7; --status-failed-bg: #452933;
  --status-launched: #86d9c9; --status-launched-bg: #183e39;
}
@theme inline {
  --shadow-sm: 0 1px 2px rgb(16 34 61 / 0.05);
  --shadow-md: 0 4px 12px rgb(16 34 61 / 0.09);
  --shadow-lg: 0 12px 32px rgb(16 34 61 / 0.15);
}
@layer base {
  * { scrollbar-width: thin; scrollbar-color: var(--input) transparent; }
  body { margin: 0; line-height: 1.6; }
  button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
  button, a { touch-action: manipulation; }
  :focus-visible { outline: 2px solid var(--ring); outline-offset: 3px; }
  ::selection { background: var(--accent); color: var(--accent-foreground); }
  input, textarea { caret-color: var(--primary); }
  h1 { font-size: var(--text-page); font-weight: 650; line-height: 1.3; letter-spacing: -0.02em; }
  h2 { line-height: 1.4; }
  a { text-underline-offset: 3px; }
  table, time, dd { font-variant-numeric: tabular-nums; }
  p, li { overflow-wrap: anywhere; }
}
@layer components {
  .page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.5rem; }
  .page-header h1 { font-size: var(--text-page); }
  .page-header p { margin-top: 0.5rem; max-width: 70ch; color: var(--muted-foreground); font-size: var(--text-body); }
  .section-title { margin-bottom: 1rem; font-size: var(--text-section); font-weight: 600; }
  .status-running { background: var(--status-running-bg); color: var(--status-running); }
  .status-waiting { background: var(--status-waiting-bg); color: var(--status-waiting); }
  .status-done { background: var(--status-done-bg); color: var(--status-done); }
  .status-failed { background: var(--status-failed-bg); color: var(--status-failed); }
  .status-launched { background: var(--status-launched-bg); color: var(--status-launched); }
  .skip-link { position: fixed; top: -6rem; left: 1rem; z-index: 100; padding: 0.5rem 1rem; border-radius: 0.5rem; background: var(--primary); color: var(--primary-foreground); }
  .skip-link:focus { top: 1rem; }
  .console-sidebar { width: 15rem; }
  .assistant-launcher { position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 60; display: flex; height: 4.5rem; min-width: 4.5rem; align-items: center; justify-content: center; gap: 0.25rem; border: 1px solid color-mix(in srgb, var(--primary) 24%, var(--border)); border-radius: 999px; background: color-mix(in srgb, var(--card) 94%, var(--primary) 6%); padding: 0.2rem 0.65rem 0.2rem 0.2rem; color: var(--foreground); box-shadow: 0 14px 35px rgb(16 34 61 / 0.2); transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease; }
  .assistant-launcher:hover { transform: translateY(-3px) rotate(-1deg); background: color-mix(in srgb, var(--card) 88%, var(--primary) 12%); box-shadow: 0 18px 42px rgb(16 34 61 / 0.26); }
  .assistant-launcher:focus-visible { outline-offset: 4px; }
  .assistant-launcher .pi-mascot { width: 3.9rem; height: 3.9rem; }
  .assistant-launcher-label { padding-right: 0.25rem; font-size: 0.75rem; font-weight: 650; white-space: nowrap; }
  .assistant-launcher-close { width: 0.9rem; height: 0.9rem; color: var(--muted-foreground); }
  .assistant-unread { position: absolute; top: 0.15rem; right: 0.25rem; width: 0.7rem; height: 0.7rem; border: 2px solid var(--card); border-radius: 999px; background: var(--destructive); box-shadow: 0 0 0 2px color-mix(in srgb, var(--destructive) 25%, transparent); }
  .assistant-panel { position: fixed; right: 1.25rem; bottom: 6.25rem; z-index: 55; display: flex; width: min(25rem, calc(100vw - 2rem)); height: min(42rem, calc(100dvh - 8rem)); min-height: min(26rem, calc(100dvh - 8rem)); flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: 1.15rem; background: var(--card); color: var(--card-foreground); box-shadow: 0 24px 70px rgb(16 34 61 / 0.25); animation: assistant-panel-in 180ms ease-out both; }
  .assistant-messages { display: flex; min-height: 0; flex: 1; flex-direction: column; gap: 0.85rem; overflow-y: auto; overscroll-behavior: contain; padding: 1rem; }
  .pi-mascot { display: block; overflow: visible; animation: pi-float 3.2s ease-in-out infinite; }
  .pi-body { fill: color-mix(in srgb, var(--primary) 72%, #ffd9ec); stroke: color-mix(in srgb, var(--primary) 75%, #28324d); stroke-width: 2; }
  .pi-highlight { fill: none; stroke: rgb(255 255 255 / 0.72); stroke-linecap: round; stroke-width: 3; }
  .pi-shadow { fill: rgb(16 34 61 / 0.16); transform-origin: center; animation: pi-shadow 3.2s ease-in-out infinite; }
  .pi-face { fill: var(--foreground); stroke: var(--foreground); stroke-linecap: round; stroke-width: 1.8; }
  .pi-face ellipse { transform-box: fill-box; transform-origin: center; animation: pi-blink 5.4s ease-in-out infinite; }
  .pi-cheek { fill: none; stroke: #e87591; stroke-linecap: round; stroke-width: 2.3; opacity: 0.85; }
  .pi-arm { fill: none; stroke: color-mix(in srgb, var(--primary) 78%, #28324d); stroke-linecap: round; stroke-width: 4; transform-box: fill-box; transform-origin: left bottom; }
  .assistant-launcher:hover .pi-arm { animation: pi-wave 520ms ease-in-out 2; }
  .assistant-launcher:hover .pi-face { transform-box: fill-box; transform-origin: center; transform: rotate(-4deg); }
  .pi-mascot-busy { animation: pi-busy 760ms ease-in-out infinite alternate; }
  .pi-mascot-happy { animation: pi-happy 520ms ease-out 2; }
  .pi-orbit { fill: var(--primary); transform-origin: 59px 19px; animation: pi-orbit 1.1s linear infinite; }
  .assistant-launcher.is-happy { animation: pi-launcher-happy 620ms ease-out 2; }
}
@keyframes assistant-panel-in { from { opacity: 0; transform: translateY(0.75rem) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes pi-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
@keyframes pi-shadow { 0%, 100% { transform: scaleX(1); opacity: 0.16; } 50% { transform: scaleX(0.82); opacity: 0.1; } }
@keyframes pi-blink { 0%, 44%, 48%, 100% { transform: scaleY(1); } 46% { transform: scaleY(0.08); } }
@keyframes pi-wave { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(22deg); } }
@keyframes pi-busy { from { transform: rotate(-3deg) translateY(-1px); } to { transform: rotate(3deg) translateY(1px); } }
@keyframes pi-orbit { to { transform: rotate(360deg); } }
@keyframes pi-happy { 0%, 100% { transform: translateY(0) scale(1); } 45% { transform: translateY(-7px) scale(1.04); } }
@keyframes pi-launcher-happy { 0%, 100% { transform: translateY(0); } 45% { transform: translateY(-7px); } }
@media (max-width: 767px) {
  .console-sidebar { position: fixed; z-index: 40; top: 0; bottom: 0; left: 0; width: min(19rem,85vw); visibility: hidden; transform: translateX(-100%); transition: transform 150ms ease-out, visibility 150ms; }
  .console-sidebar.mobile-open { visibility: visible; transform: translateX(0); }
  .page-header { gap: 1rem; flex-wrap: wrap; }
  [data-slot="dialog-content"] { max-height: calc(100dvh - 2rem); overflow-y: auto; }
  .assistant-panel { right: 0; bottom: 5.7rem; left: 0; width: 100%; height: min(38rem, calc(100dvh - 6.25rem)); min-height: min(22rem, calc(100dvh - 6.25rem)); border-right: 0; border-bottom: 0; border-left: 0; border-radius: 1.15rem 1.15rem 0 0; }
  .assistant-launcher { right: 0.75rem; bottom: 0.75rem; }
  .assistant-launcher-label { display: none; }
}
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-name: none !important; animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; } }
