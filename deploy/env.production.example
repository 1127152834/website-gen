# Server-only /opt/website-gen/shared/.env, mode 0600. Never commit real values.
# Simple unquoted KEY=value entries; no shell expansion. Do not use inline comments.
HOST=0.0.0.0
PORT=8787
TRUST_PROXY=1
SITE_ADDRESS=tool.aoeen.com
CF_SSL_MODE=full
ADMIN_USERNAME=admin
# Replace before first deploy. For example generate with: openssl rand -hex 24
ADMIN_PASSWORD=CHANGE_ME_BEFORE_FIRST_DEPLOY
# Leave empty to persist /app/data/master.key (required for desktop import).
WEBSITE_GEN_MASTER_KEY=
ALLOW_PRIVATE_MODEL_HOSTS=0
