{
  # Keep internal certificate issuance/renewal enabled, never public ACME.
  local_certs
  skip_install_trust
  servers {
    import /etc/website-gen/cloudflare/cloudflare.caddy
    trusted_proxies_strict
    client_ip_headers CF-Connecting-IP
    protocols h1 h2
  }
}

(app_forward) {
  # Replace, never append visitor-controlled forwarding headers.
  header_up X-Forwarded-For {client_ip}
  header_up X-Forwarded-Proto https
  header_up -CF-Connecting-IP
  header_up -X-Real-IP
  header_up -Forwarded
}

{$SITE_ADDRESS:tool.aoeen.com} {
  # Cloudflare SSL mode Full accepts this local CA. No public ACME challenges.
  tls internal
  # Static readiness only; the deploy script separately checks app health.
  respond /_origin_health "ready" 200
  # Missing/invalid CF-Connecting-IP resolves to the immediate peer. Fail closed
  # rather than putting all visitors into a Cloudflare-edge rate-limit bucket.
  @unresolved expression {client_ip} == {remote_host}
  respond @unresolved "Unresolved client IP" 400
  @events path /api/events
  reverse_proxy @events app:8787 {
    import app_forward
    flush_interval -1
  }
  reverse_proxy app:8787 {
    import app_forward
  }
}
