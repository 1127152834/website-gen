# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# Web 服务（本机默认只监听 127.0.0.1:8787；Docker Compose 会覆盖 HOST）
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data

# 32 字节随机值的 base64。留空会在 data/master.key 生成；生产环境应备份该文件。
# 可用 node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))" 生成。
WEBSITE_GEN_MASTER_KEY=

# 首次启动的管理员。ADMIN_PASSWORD 留空时会在控制台只打印一次随机临时密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 只有在可信反向代理终止 HTTPS 时设为 1，使会话 Cookie 带 Secure。
TRUST_PROXY=0

# Docker Compose：app 对宿主机的绑定，以及启用 Caddy HTTPS 时的公网域名。
APP_BIND=127.0.0.1
APP_PORT=8787
SITE_ADDRESS=example.com

# DeepSeek（OpenAI 格式与 Anthropic 格式共用同一个 Key）
DEEPSEEK_API_KEY=

# Hostinger API Token（hPanel → API）。每个账号一行，变量名后缀是你给账号起的标签
HOSTINGER_TOKEN_AGENCY=
HOSTINGER_TOKEN_BUSINESS=
HOSTINGER_TOKEN_CLOUD=

# CJdropshipping API Key（CJ 后台 → API Key 管理）。系统用它换 accessToken，MCP 和 REST 都用 accessToken
CJ_API_KEY=

# POC 用：可以随意修改 DNS 的测试域名（必须在上面某个 Hostinger 账号里）
POC_TEST_DOMAIN=
